<?xml version="1.0"?>
<xml-datacollection-config rrdRepository="target/snmp/" xmlns="http://xmlns.opennms.org/xsd/config/xml-datacollection">
    <xml-collection name="invalid-json-names">
        <rrd step="300">
            <rra>RRA:AVERAGE:0.5:1:2016</rra>
            <rra>RRA:AVERAGE:0.5:12:1488</rra>
            <rra>RRA:MIN:0.5:12:1488</rra>
            <rra>RRA:MAX:0.5:12:1488</rra>
        </rrd>
        <xml-source url="http://{ipaddr}:10342/junit/NMS-15222.json">
            <!-- A key starting with a digit in the middle of an object xpath. -->
            <xml-group name="http-stats" resource-type="node"
                resource-xpath="/stats">
                <xml-object name="ok" type="GAUGE" xpath="2xx/count"/>
                <xml-object name="failed" type="GAUGE" xpath="5xx/count"/>
            </xml-group>
            <!-- A key starting with a digit holding an array: this has to yield one resource per
                 element, and a key containing an apostrophe. -->
            <xml-group name="if-stats" resource-type="invalidNameIf"
                resource-xpath="/2interfaces"
                key-xpath="@if">
                <xml-object name="oneMin" type="GAUGE" xpath="1min"/>
                <xml-object name="obrien" type="GAUGE" xpath="o'brien"/>
            </xml-group>
            <!-- The same array through the multiple-key code path. -->
            <xml-group name="if-keyed" resource-type="invalidNameIf2"
                resource-xpath="/2interfaces">
                <xml-object name="oneMin" type="GAUGE" xpath="1min"/>
                <resource-key>
                    <key-xpath>@if</key-xpath>
                    <key-xpath>@2name</key-xpath>
                </resource-key>
            </xml-group>
        </xml-source>
    </xml-collection>
</xml-datacollection-config>
