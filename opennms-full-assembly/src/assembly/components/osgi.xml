<component
    xmlns="http://maven.apache.org/plugins/maven-assembly-plugin/component/1.1.2"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/plugins/maven-assembly-plugin/component/1.1.2 http://maven.apache.org/xsd/component-1.1.2.xsd"
>
  <fileSets>
    <fileSet>
      <filtered>false</filtered>
      <outputDirectory>system</outputDirectory>
      <directory>target/opennms-repo</directory>
      <excludes>
        <exclude>**/*jasypt*/1.9.2_1</exclude>
        <exclude>**/*jasypt*/1.9.2_1/*</exclude>
        <exclude>**/jettison/1.3.*</exclude>
        <exclude>**/jettison/1.3.*/*</exclude>
        <exclude>**/jettison/1.4.*</exclude>
        <exclude>**/jettison/1.4.*/*</exclude>
        <exclude>**/proton-j/0.14.0</exclude>
        <exclude>**/proton-j/0.14.0/*</exclude>
        <exclude>**/proton-j/0.26.0</exclude>
        <exclude>**/proton-j/0.26.0/*</exclude>
        <exclude>**/scala-library/2.11.0</exclude>
        <exclude>**/scala-library/2.11.0/*</exclude>
        <exclude>**/sshd-*/2.8.0</exclude>
        <exclude>**/sshd-*/2.8.0/*</exclude>
        <exclude>**/*xstream*/1.4.8_1</exclude>
        <exclude>**/*xstream*/1.4.8_1/*</exclude>
        <exclude>%regex[.*org\/bouncycastle\/(bcprov|bctls|bcutil|bcpkix)-jdk18on\/1.7[56]\/?.*]</exclude>
        <exclude>**/commons-io/commons-io/2.8.0</exclude>
        <exclude>**/commons-io/commons-io/2.8.0/*</exclude>
        <exclude>**/commons-io/commons-io/2.11.0</exclude>
        <exclude>**/commons-io/commons-io/2.11.0/*</exclude>
        <exclude>**/commons-io/commons-io/2.13.0</exclude>
        <exclude>**/commons-io/commons-io/2.13.0/*</exclude>
        <exclude>**/zookeeper/3.4.14</exclude>
        <exclude>**/zookeeper/3.4.14/*</exclude>
        <exclude>/org/eclipse/jetty/**/9.4.52.v20230823</exclude>
        <exclude>/org/eclipse/jetty/**/9.4.52.v20230823/*</exclude>
        <exclude>com/fasterxml/jackson/core/jackson-core/2.13.*</exclude>
        <exclude>com/fasterxml/jackson/core/jackson-core/2.13.*/*</exclude>
        <exclude>com/fasterxml/jackson/core/jackson-core/2.14.*</exclude>
        <exclude>com/fasterxml/jackson/core/jackson-core/2.14.*/*</exclude>
        <exclude>com/fasterxml/jackson/core/jackson-databind/2.9.*</exclude>
        <exclude>com/fasterxml/jackson/core/jackson-databind/2.9.*/*</exclude>
        <exclude>com/fasterxml/jackson/**/2.20.*</exclude>
        <exclude>com/fasterxml/jackson/**/2.20.*/*</exclude>
        <exclude>com/fasterxml/jackson/core/jackson-annotations/2.20</exclude>
        <exclude>com/fasterxml/jackson/core/jackson-annotations/2.20/*</exclude>
        <exclude>io/netty/netty-*/4.1.22.Final</exclude>
        <exclude>io/netty/netty-*/4.1.22.Final/*</exclude>
        <exclude>org/ops4j/pax/logging/pax-logging-log4j2/1.10.2</exclude>
        <exclude>org/ops4j/pax/logging/pax-logging-log4j2/1.10.2/*</exclude>
        <exclude>io/netty/netty-codec-http/4.1.22.Final</exclude>
        <exclude>io/netty/netty-codec-http/4.1.22.Final/*</exclude>
        <!-- NMS-20061: Karaf's own feature repository pins a jline (3.21.0 for Karaf 4.3.10)
             affected by CVE-2026-56740 / CVE-2026-56741. Only ${jlineVersion} from the root
             pom may ship. Keyed off the property on purpose so it stays correct across jline
             *and* Karaf bumps - do NOT hardcode a version here. Belt-and-braces: the
             "remove-superseded-jline" antrun execution in opennms-full-assembly/pom.xml
             already prunes target/opennms-repo at process-classes, before this descriptor is
             read at package. -->
        <exclude>%regex[.*org/jline/jline/(?!\Q${jlineVersion}\E(/|\z)).*]</exclude>
      </excludes>
    </fileSet>

  </fileSets>
</component>
