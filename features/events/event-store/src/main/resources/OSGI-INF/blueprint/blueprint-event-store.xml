<blueprint xmlns="http://www.osgi.org/xmlns/blueprint/v1.0.0"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:cm="http://aries.apache.org/blueprint/xmlns/blueprint-cm/v1.3.0"
           xsi:schemaLocation="
        http://www.osgi.org/xmlns/blueprint/v1.0.0
        https://osgi.org/xmlns/blueprint/v1.0.0/blueprint.xsd
        http://aries.apache.org/blueprint/xmlns/blueprint-cm/v1.3.0
        http://aries.apache.org/schemas/blueprint-cm/blueprint-cm-1.3.0.xsd">

    <!-- ================================================================ -->
    <!-- Configuration from org.opennms.features.events.store.cfg         -->
    <!-- ================================================================ -->
    <cm:property-placeholder id="eventStoreProperties"
                             persistent-id="org.opennms.features.events.store"
                             update-strategy="reload">
        <cm:default-properties>
            <cm:property name="datasource.host" value="localhost"/>
            <cm:property name="datasource.port" value="5432"/>
            <cm:property name="datasource.database" value="opennms"/>
            <cm:property name="datasource.username" value="opennms"/>
            <cm:property name="datasource.password" value="opennms"/>
        </cm:default-properties>
    </cm:property-placeholder>

    <!-- ================================================================ -->
    <!-- OSGi service references                                          -->
    <!-- ================================================================ -->

    <!-- EventSubscriptionService: provided by event-forwarder-kafka
         (KafkaEventSubscriptionService via KafkaEventIpcManagerAdapter) -->
    <reference id="eventSubscriptionService"
               interface="org.opennms.netmgt.events.api.EventSubscriptionService"
               availability="mandatory"/>

    <!-- ================================================================ -->
    <!-- Beans                                                            -->
    <!-- ================================================================ -->

    <!-- Lightweight JDBC DataSource using PostgreSQL's native DataSource.
         Avoids OSGi classloading issues with DriverManager.
         Uses EventArchiveWriterFactory to create both DataSource and writer
         from String args (Blueprint type-matching safe). -->
    <bean id="eventArchiveWriter"
          class="org.opennms.features.events.store.EventArchiveWriterFactory"
          factory-method="create"
          init-method="register"
          destroy-method="unregister">
        <argument value="${datasource.host}"/>
        <argument value="${datasource.port}" type="int"/>
        <argument value="${datasource.database}"/>
        <argument value="${datasource.username}"/>
        <argument value="${datasource.password}"/>
        <property name="eventSubscriptionService" ref="eventSubscriptionService"/>
    </bean>

</blueprint>
