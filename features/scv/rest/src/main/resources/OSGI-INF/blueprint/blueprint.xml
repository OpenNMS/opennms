<blueprint
        xmlns="http://www.osgi.org/xmlns/blueprint/v1.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.osgi.org/xmlns/blueprint/v1.0.0 http://www.osgi.org/xmlns/blueprint/v1.0.0/blueprint.xsd"
>
    <reference id="secureCredentialsVault" interface="org.opennms.features.scv.api.SecureCredentialsVault" availability="mandatory"/>
    <reference id="eventForwarder" interface="org.opennms.netmgt.events.api.EventForwarder" availability="optional"/>

    <bean id="credentialsChangedListener" class="org.opennms.features.scv.rest.EventForwardingCredentialsChangedListener">
        <argument ref="eventForwarder"/>
    </bean>

    <!-- exposed so the SCV shell commands (whose bundle cannot depend on the event API) can notify on changes -->
    <service interface="org.opennms.features.scv.api.CredentialsChangedListener" ref="credentialsChangedListener"/>

    <bean id="defaultScvRestService" class="org.opennms.features.scv.rest.DefaultScvRestService">
        <argument ref="secureCredentialsVault"/>
        <argument ref="credentialsChangedListener"/>
    </bean>

    <service interface="org.opennms.features.scv.rest.ScvRestService" ref="defaultScvRestService">
        <service-properties>
            <entry key="application-path" value="/rest" />
        </service-properties>
    </service>
</blueprint>
