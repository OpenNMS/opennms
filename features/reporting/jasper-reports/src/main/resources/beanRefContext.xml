<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans-4.2.xsd">
        
   <bean id="jasperReportContext" class="org.springframework.context.support.ClassPathXmlApplicationContext" lazy-init="true">
     <constructor-arg>
       <list>
         <!-- Jasper reporting is initialized by the shared reporting context. -->
       </list>
     </constructor-arg>
     <constructor-arg ref="reportingCoreContext" />
   </bean>
   <bean id="measurementDataSourceContext" class="org.springframework.context.support.ClassPathXmlApplicationContext" lazy-init="true">
     <constructor-arg>
       <list>
         <!-- Measurement services are initialized by the shared measurements context. -->
       </list>
     </constructor-arg>
     <constructor-arg ref="measurementsContext" />
   </bean>
</beans>
