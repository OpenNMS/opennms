<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans-4.2.xsd" default-lazy-init="true">
        
   <bean id="daoContext" class="org.springframework.context.support.ClassPathXmlApplicationContext">
     <constructor-arg>
       <list>
         <value>META-INF/opennms/applicationContext-dao.xml</value>
         <value>classpath*:/META-INF/opennms/component-dao.xml</value>
         <!-- OSGi services that must be published even if the daemon that uses them is disabled (NMS-20470) -->
         <value>classpath*:/META-INF/opennms/component-shared-services.xml</value>
       </list>
     </constructor-arg>
     <constructor-arg ref="daemonContext" />
   </bean>
   
</beans>
