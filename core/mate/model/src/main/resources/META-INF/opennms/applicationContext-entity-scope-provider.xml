<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xmlns:onmsgi="http://xmlns.opennms.org/xsd/spring/onms-osgi"
       xsi:schemaLocation="
           http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans-4.2.xsd
           http://www.springframework.org/schema/context
           http://www.springframework.org/schema/context/spring-context-4.2.xsd
           http://xmlns.opennms.org/xsd/spring/onms-osgi http://xmlns.opennms.org/xsd/spring/onms-osgi.xsd
        ">

    <context:annotation-config />

    <!-- Internal implementation with autowired dependencies -->
    <bean name="entityScopeProviderImpl" class="org.opennms.core.mate.model.EntityScopeProviderImpl"/>

    <!-- Factory that returns either the real impl or no-op based on system property -->
    <bean name="entityScopeProvider" class="org.opennms.core.mate.model.EntityScopeProviderFactory" primary="true">
        <property name="delegate" ref="entityScopeProviderImpl"/>
    </bean>

    <onmsgi:service ref="entityScopeProvider" interface="org.opennms.core.mate.api.EntityScopeProvider"/>
</beans>
