<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-2.0.xsd http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <!-- Event definitions inside a source were only ordered by their primary key, which is
         insertion order and cannot be changed. event_order makes the within-source evaluation
         order explicit: ascending, 1 = evaluated first. Sources keep their existing file_order
         (descending: higher = evaluated first).

         Any later changeset that inserts into eventconf_events must set event_order, e.g.
         (SELECT COALESCE(MAX(event_order), 0) + 1 FROM eventconf_events WHERE source_id = ...). -->

    <changeSet author="cgorantla" id="36.0.4-eventconf-events-event-order-column">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="eventconf_events"/>
            <not>
                <columnExists tableName="eventconf_events" columnName="event_order"/>
            </not>
        </preConditions>
        <addColumn tableName="eventconf_events">
            <column name="event_order" type="integer"/>
        </addColumn>
        <rollback>
            <dropColumn tableName="eventconf_events" columnName="event_order"/>
        </rollback>
    </changeSet>

    <changeSet author="cgorantla" id="36.0.4-eventconf-events-event-order-backfill">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="eventconf_events" columnName="event_order"/>
        </preConditions>
        <sql>
            UPDATE eventconf_events e
            SET event_order = r.rn
            FROM (
                SELECT id, ROW_NUMBER() OVER (PARTITION BY source_id ORDER BY id) AS rn
                FROM eventconf_events
            ) r
            WHERE e.id = r.id
              AND e.event_order IS NULL;
        </sql>
        <addNotNullConstraint tableName="eventconf_events" columnName="event_order" columnDataType="integer"/>
        <rollback>
            <!-- the backfilled values need no inverse: the column itself is dropped by the previous changeset's rollback -->
            <dropNotNullConstraint tableName="eventconf_events" columnName="event_order" columnDataType="integer"/>
        </rollback>
    </changeSet>

    <changeSet author="cgorantla" id="36.0.4-eventconf-events-source-order-index">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="eventconf_events" columnName="event_order"/>
            <not>
                <indexExists indexName="idx_eventconf_events_source_order"/>
            </not>
        </preConditions>
        <createIndex tableName="eventconf_events" indexName="idx_eventconf_events_source_order">
            <column name="source_id"/>
            <column name="event_order"/>
        </createIndex>
        <rollback>
            <dropIndex tableName="eventconf_events" indexName="idx_eventconf_events_source_order"/>
        </rollback>
    </changeSet>

    <!-- eventconf_sources.file_order is the source precedence (higher = evaluated first) and is meant to be
         unique: MAX+1 allocation and the eventconf.xml renumbering never intend to produce duplicates, but
         nothing enforced it. Repair any duplicates deterministically (relative order kept, the catch-all
         stays lowest, among equals the newer row is evaluated first), then add the constraint. It is DEFERRABLE so a reorder can rewrite every row in one
         transaction without tripping over intermediate collisions. -->
    <changeSet author="cgorantla" id="36.0.4-eventconf-sources-file-order-dedupe">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="eventconf_sources"/>
            <not>
                <sqlCheck expectedResult="0">
                    SELECT COUNT(*) FROM (
                        SELECT file_order FROM eventconf_sources GROUP BY file_order HAVING COUNT(*) > 1
                    ) d
                </sqlCheck>
            </not>
        </preConditions>
        <sql>
            UPDATE eventconf_sources s
            SET file_order = r.rn
            FROM (
                SELECT id,
                       ROW_NUMBER() OVER (ORDER BY (name = 'opennms.catch-all.events') DESC, file_order ASC, id ASC) AS rn
                FROM eventconf_sources
            ) r
            WHERE s.id = r.id
              AND s.file_order &lt;&gt; r.rn;
        </sql>
        <!-- The renumbering keeps the relative order and is only performed when duplicates exist;
             there is no meaningful previous state to restore, so rolling back is a no-op. -->
        <rollback/>
    </changeSet>

    <changeSet author="cgorantla" id="36.0.4-eventconf-sources-file-order-unique">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="eventconf_sources"/>
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM pg_constraint WHERE conname = 'uk_eventconf_sources_file_order'
            </sqlCheck>
        </preConditions>
        <addUniqueConstraint tableName="eventconf_sources" columnNames="file_order"
                             constraintName="uk_eventconf_sources_file_order"
                             deferrable="true" initiallyDeferred="true"/>
        <rollback>
            <dropUniqueConstraint tableName="eventconf_sources" constraintName="uk_eventconf_sources_file_order"/>
        </rollback>
    </changeSet>

    <!-- file_order 1 is reserved for the catch-all (the source that must be evaluated last). Move any other
         source off it and put the catch-all there, so allocation can pin the catch-all at 1 without ever
         having to shift other rows at runtime. -->
    <changeSet author="cgorantla" id="36.0.4-eventconf-sources-catch-all-slot">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="eventconf_sources"/>
        </preConditions>
        <sql>
            UPDATE eventconf_sources
            SET file_order = file_order + 1
            WHERE name &lt;&gt; 'opennms.catch-all.events'
              AND EXISTS (
                  SELECT 1 FROM eventconf_sources o
                  WHERE o.file_order = 1 AND o.name &lt;&gt; 'opennms.catch-all.events'
              );
            UPDATE eventconf_sources
            SET file_order = 1
            WHERE name = 'opennms.catch-all.events'
              AND file_order &lt;&gt; 1;
        </sql>
        <rollback/>
    </changeSet>

    <!-- New sources take their file_order from a sequence instead of a locked MAX+1, so creating a source no
         longer holds a global lock for the duration of its (possibly very large) event insert. Values are
         monotonic and always above every existing value: the sequence starts past the current maximum and the
         only operations that ever lower a value (the eventconf.xml renumbering) keep them below it. Gaps are
         harmless, only the relative order matters. -->
    <changeSet author="cgorantla" id="36.0.4-eventconf-sources-file-order-sequence">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="eventconf_sources"/>
            <sqlCheck expectedResult="0">
                SELECT COUNT(relname) FROM pg_class, pg_namespace
                WHERE relkind='S' AND pg_class.relnamespace = pg_namespace.oid AND relname ILIKE 'eventconf_sources_file_order_seq'
            </sqlCheck>
        </preConditions>
        <createSequence sequenceName="eventconf_sources_file_order_seq" minValue="2" startValue="2"/>
        <sql>
            SELECT setval('eventconf_sources_file_order_seq',
                          GREATEST(COALESCE((SELECT MAX(file_order) FROM eventconf_sources), 1), 1) + 1,
                          false);
        </sql>
        <rollback>
            <dropSequence sequenceName="eventconf_sources_file_order_seq"/>
        </rollback>
    </changeSet>

    <!-- Within a source, event_order is meant to be unique the same way file_order is between sources: the
         appender serializes on the source row and the compaction renumbers densely, but nothing verified the
         end state. Repair any duplicates (relative order kept), then enforce it. DEFERRABLE so the compaction
         and a full re-upload can rewrite positions inside one transaction. The plain index is replaced by the
         constraint's unique index. -->
    <changeSet author="cgorantla" id="36.0.4-eventconf-events-event-order-dedupe">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="eventconf_events" columnName="event_order"/>
            <not>
                <sqlCheck expectedResult="0">
                    SELECT COUNT(*) FROM (
                        SELECT source_id, event_order FROM eventconf_events GROUP BY source_id, event_order HAVING COUNT(*) > 1
                    ) d
                </sqlCheck>
            </not>
        </preConditions>
        <sql>
            UPDATE eventconf_events e
            SET event_order = r.rn
            FROM (
                SELECT id, ROW_NUMBER() OVER (PARTITION BY source_id ORDER BY event_order, id) AS rn
                FROM eventconf_events
                WHERE source_id IN (
                    SELECT source_id FROM eventconf_events GROUP BY source_id, event_order HAVING COUNT(*) > 1
                )
            ) r
            WHERE e.id = r.id
              AND e.event_order &lt;&gt; r.rn;
        </sql>
        <rollback/>
    </changeSet>

    <changeSet author="cgorantla" id="36.0.4-eventconf-events-source-order-unique">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="eventconf_events" columnName="event_order"/>
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM pg_constraint WHERE conname = 'uk_eventconf_events_source_order'
            </sqlCheck>
        </preConditions>
        <addUniqueConstraint tableName="eventconf_events" columnNames="source_id, event_order"
                             constraintName="uk_eventconf_events_source_order"
                             deferrable="true" initiallyDeferred="true"/>
        <dropIndex tableName="eventconf_events" indexName="idx_eventconf_events_source_order"/>
        <rollback>
            <createIndex tableName="eventconf_events" indexName="idx_eventconf_events_source_order">
                <column name="source_id"/>
                <column name="event_order"/>
            </createIndex>
            <dropUniqueConstraint tableName="eventconf_events" constraintName="uk_eventconf_events_source_order"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
