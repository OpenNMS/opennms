<blueprint xmlns="http://www.osgi.org/xmlns/blueprint/v1.0.0"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:cm="http://aries.apache.org/blueprint/xmlns/blueprint-cm/v1.3.0"
           xsi:schemaLocation="
        http://www.osgi.org/xmlns/blueprint/v1.0.0
        https://osgi.org/xmlns/blueprint/v1.0.0/blueprint.xsd
        http://aries.apache.org/blueprint/xmlns/blueprint-cm/v1.3.0
        http://aries.apache.org/schemas/blueprint-cm/blueprint-cm-1.3.0.xsd">

    <!-- ================================================================ -->
    <!-- Configuration from org.opennms.core.event.forwarder.kafka.cfg    -->
    <!-- ================================================================ -->
    <cm:property-placeholder id="eventForwarderKafkaProperties"
                             persistent-id="org.opennms.core.event.forwarder.kafka"
                             update-strategy="reload">
        <cm:default-properties>
            <cm:property name="bootstrap.servers" value="localhost:9092"/>
            <cm:property name="topic.name" value="opennms-fault-events"/>
            <cm:property name="ipc.topic.name" value="opennms-ipc-events"/>
            <cm:property name="consumer.group.id" value="opennms-core"/>
            <cm:property name="poll.timeout.ms" value="100"/>
        </cm:default-properties>
    </cm:property-placeholder>

    <!-- ================================================================ -->
    <!-- OSGi references                                                  -->
    <!-- ================================================================ -->

    <!-- EventConfEventDao: Hibernate DAO for loading eventconf from DB.
         Registered as OSGi service by distributed-dao-impl's applicationContext-shared.xml
         via onmsgi:service → OnmsOSGiBridge → OSGi Framework registry.
         Optional because distributed-dao-impl may fail to restart during Karaf feature
         refresh cycles (its own osgi:reference for serviceRegistry/dataSource times out). -->
    <reference id="eventConfEventDao"
               interface="org.opennms.netmgt.dao.api.EventConfEventDao"
               availability="optional"/>

    <!-- ================================================================ -->
    <!-- Eventconf enrichment                                             -->
    <!-- ================================================================ -->

    <!-- ================================================================ -->
    <!-- Beans                                                            -->
    <!-- ================================================================ -->

    <!-- KafkaEventForwarder: routes events to Kafka topics (fault + IPC).
         Uses KafkaEventForwarderFactory to avoid Aries Blueprint constructor/factory
         matching issues with cross-bundle interface types and generics. -->
    <bean id="kafkaEventForwarder"
          class="org.opennms.core.event.forwarder.kafka.KafkaEventForwarderFactory"
          factory-method="create">
        <argument value="${bootstrap.servers}"/>
        <argument value="${topic.name}"/>
        <property name="ipcTopicName" value="${ipc.topic.name}"/>
    </bean>

    <!-- EventConfInitializer: loads event definitions from DB on init and
         injects the resulting EventConfDao into KafkaEventForwarder for
         producer-side enrichment. Gracefully degrades if EventConfEventDao
         is unavailable (distributed-dao-impl not yet started). -->
    <bean id="eventConfInitializer"
          class="org.opennms.core.event.forwarder.kafka.EventConfInitializer"
          init-method="init">
        <argument ref="eventConfEventDao"/>
        <argument ref="kafkaEventForwarder"/>
    </bean>

    <!-- KafkaEventSubscriptionService: consumes events from Kafka topics.
         Subscribes to both fault and IPC topics (comma-separated).
         Factory method takes only String/long primitives, creating KafkaConsumer
         and XmlEventDeserializer internally to avoid Blueprint type-matching. -->
    <bean id="kafkaEventSubscriptionService"
          class="org.opennms.core.event.forwarder.kafka.KafkaEventSubscriptionService"
          factory-method="create"
          init-method="start"
          destroy-method="stop">
        <argument value="${bootstrap.servers}"/>
        <argument value="${consumer.group.id}"/>
        <argument value="${topic.name},${ipc.topic.name}"/>
        <argument value="${poll.timeout.ms}" type="long"/>
    </bean>

    <!-- Adapter: composes forwarder + subscription into EventIpcManager -->
    <bean id="kafkaEventIpcManagerAdapter"
          class="org.opennms.core.event.forwarder.kafka.KafkaEventIpcManagerAdapter">
        <argument ref="kafkaEventForwarder"/>
        <argument ref="kafkaEventSubscriptionService"/>
    </bean>

    <!-- ================================================================ -->
    <!-- OSGi service registration                                        -->
    <!-- ================================================================ -->
    <service ref="kafkaEventIpcManagerAdapter">
        <interfaces>
            <value>org.opennms.netmgt.events.api.EventForwarder</value>
            <value>org.opennms.netmgt.events.api.EventIpcBroadcaster</value>
            <value>org.opennms.netmgt.events.api.EventIpcManager</value>
            <value>org.opennms.netmgt.events.api.EventProxy</value>
            <value>org.opennms.netmgt.events.api.EventSubscriptionService</value>
        </interfaces>
    </service>

</blueprint>
