<?xml version="1.0" encoding="UTF-8"?>
<!--
  Karaf-only Notifd loader context.

  In a Karaf-only container (no Manager, no Eventd), this context replaces the
  multi-level Spring hierarchy with a flat context that wires Notifd beans
  directly to OSGi services and static config factories.

  All dependencies come from OSGi service registry:
  - EventIpcManager from KafkaEventIpcManagerAdapter (event-forwarder-kafka feature)
  - EventUtil from events-daemon feature
  - EventConfDao from opennms-config feature
  - NodeDao from distributed DAO feature
  - EntityScopeProvider from MATE feature
  - ReadablePollOutagesDao from poll-outages feature

  Static config factories (NotifdConfigFactory, NotificationFactory, GroupFactory,
  UserFactory, DestinationPathFactory, NotificationCommandFactory) are initialized
  via MethodInvokingFactoryBean, then obtained via getInstance().
-->
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xmlns:osgi="http://www.springframework.org/schema/osgi"
       xmlns:onmsgi="http://xmlns.opennms.org/xsd/spring/onms-osgi"
       xsi:schemaLocation="
           http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-4.2.xsd
           http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context-4.2.xsd
           http://www.springframework.org/schema/osgi http://www.springframework.org/schema/osgi/spring-osgi.xsd
           http://xmlns.opennms.org/xsd/spring/onms-osgi http://xmlns.opennms.org/xsd/spring/onms-osgi.xsd
       ">

    <!-- Enable @Autowired processing for Notifd and BroadcastEventProcessor -->
    <context:annotation-config />

    <!-- ServiceRegistry: import the shared instance from OSGi (registered by
         service-registry module) rather than creating a local one with
         <onmsgi:default-registry/> which would be a different, empty instance -->
    <osgi:reference id="serviceRegistry"
                    interface="org.opennms.core.soa.ServiceRegistry"/>

    <!-- ============================================================== -->
    <!-- OSGi Service References (from other Karaf features)            -->
    <!-- ============================================================== -->

    <!-- Event infrastructure (from opennms-event-forwarder-kafka blueprint) -->
    <osgi:reference id="eventIpcManager"
                    interface="org.opennms.netmgt.events.api.EventIpcManager"/>

    <!-- EventUtil (from events-daemon feature) -->
    <onmsgi:reference id="eventUtil"
                      interface="org.opennms.netmgt.eventd.EventUtil"/>

    <!-- EventConfDao (from opennms-config feature) -->
    <onmsgi:reference id="eventConfDao"
                      interface="org.opennms.netmgt.config.api.EventConfDao"/>

    <!-- DAOs (from opennms-distributed-core-impl / opennms-dao feature) -->
    <onmsgi:reference id="nodeDao"
                      interface="org.opennms.netmgt.dao.api.NodeDao"/>

    <!-- EntityScopeProvider (from MATE feature) -->
    <onmsgi:reference id="entityScopeProvider"
                      interface="org.opennms.core.mate.api.EntityScopeProvider"/>

    <!-- ReadablePollOutagesDao (from poll-outages feature) -->
    <onmsgi:reference id="pollOutagesDao"
                      interface="org.opennms.netmgt.config.dao.outages.api.ReadablePollOutagesDao"/>

    <!-- ============================================================== -->
    <!-- Static Config Factory Initialization                           -->
    <!-- ============================================================== -->

    <!-- NotifdConfigFactory -->
    <bean id="notifdConfigFactory-init" class="org.springframework.beans.factory.config.MethodInvokingFactoryBean">
        <property name="staticMethod" value="org.opennms.netmgt.config.NotifdConfigFactory.init"/>
    </bean>
    <bean id="notifdConfigFactory" class="org.opennms.netmgt.config.NotifdConfigFactory"
          depends-on="notifdConfigFactory-init" factory-method="getInstance"/>

    <!-- NotificationFactory (extends NotificationManager) -->
    <bean id="notificationFactory-init" class="org.springframework.beans.factory.config.MethodInvokingFactoryBean">
        <property name="staticMethod" value="org.opennms.netmgt.config.NotificationFactory.init"/>
    </bean>
    <bean id="notificationFactory" class="org.opennms.netmgt.config.NotificationFactory"
          depends-on="notificationFactory-init" factory-method="getInstance"/>

    <!-- GroupFactory (extends GroupManager) -->
    <bean id="groupFactory-init" class="org.springframework.beans.factory.config.MethodInvokingFactoryBean">
        <property name="staticMethod" value="org.opennms.netmgt.config.GroupFactory.init"/>
    </bean>
    <bean id="groupFactory" class="org.opennms.netmgt.config.GroupFactory"
          depends-on="groupFactory-init" factory-method="getInstance"/>

    <!-- UserFactory (extends UserManager) -->
    <bean id="userFactory-init" class="org.springframework.beans.factory.config.MethodInvokingFactoryBean">
        <property name="staticMethod" value="org.opennms.netmgt.config.UserFactory.init"/>
    </bean>
    <bean id="userFactory" class="org.opennms.netmgt.config.UserFactory"
          depends-on="userFactory-init" factory-method="getInstance"/>

    <!-- DestinationPathFactory (extends DestinationPathManager) -->
    <bean id="destinationPathFactory-init" class="org.springframework.beans.factory.config.MethodInvokingFactoryBean">
        <property name="staticMethod" value="org.opennms.netmgt.config.DestinationPathFactory.init"/>
    </bean>
    <bean id="destinationPathFactory" class="org.opennms.netmgt.config.DestinationPathFactory"
          depends-on="destinationPathFactory-init" factory-method="getInstance"/>

    <!-- NotificationCommandFactory (extends NotificationCommandManager) -->
    <bean id="notificationCommandFactory-init" class="org.springframework.beans.factory.config.MethodInvokingFactoryBean">
        <property name="staticMethod" value="org.opennms.netmgt.config.NotificationCommandFactory.init"/>
    </bean>
    <bean id="notificationCommandFactory" class="org.opennms.netmgt.config.NotificationCommandFactory"
          depends-on="notificationCommandFactory-init" factory-method="getInstance"/>

    <!-- ============================================================== -->
    <!-- BroadcastEventProcessor                                        -->
    <!-- ============================================================== -->

    <!--
      BroadcastEventProcessor uses @Autowired for:
        - EventIpcManager (m_eventManager)
        - EventUtil (m_eventUtil)
        - ReadablePollOutagesDao (m_pollOutagesDao)
        - EntityScopeProvider (m_entityScopeProvider)
      and setter injection for config managers + eventConfDao.
    -->
    <bean id="broadcastEventProcessor" class="org.opennms.netmgt.notifd.BroadcastEventProcessor">
        <property name="notifdConfigManager" ref="notifdConfigFactory"/>
        <property name="notificationManager" ref="notificationFactory"/>
        <property name="groupManager" ref="groupFactory"/>
        <property name="userManager" ref="userFactory"/>
        <property name="destinationPathManager" ref="destinationPathFactory"/>
        <property name="notificationCommandManager" ref="notificationCommandFactory"/>
        <property name="eventConfDao" ref="eventConfDao"/>
    </bean>

    <!-- ============================================================== -->
    <!-- NotificationTester (OSGi service)                              -->
    <!-- ============================================================== -->

    <bean id="notificationTester" class="org.opennms.netmgt.notifd.NotificationTesterImpl">
        <constructor-arg ref="broadcastEventProcessor"/>
        <constructor-arg ref="notificationFactory"/>
        <constructor-arg ref="notificationCommandFactory"/>
        <constructor-arg ref="groupFactory"/>
        <constructor-arg ref="userFactory"/>
    </bean>
    <onmsgi:service interface="org.opennms.netmgt.notifd.api.NotificationTester"
                    ref="notificationTester"/>

    <!-- ============================================================== -->
    <!-- NotificationConfigProvider (OSGi service)                      -->
    <!-- ============================================================== -->

    <bean id="notificationConfigProvider" class="org.opennms.netmgt.notifd.NotificationConfigProviderImpl">
        <constructor-arg ref="destinationPathFactory"/>
    </bean>
    <onmsgi:service interface="org.opennms.netmgt.notifd.api.NotificationConfigProvider"
                    ref="notificationConfigProvider"/>

    <!-- ============================================================== -->
    <!-- Notifd Daemon                                                  -->
    <!-- ============================================================== -->

    <!--
      Notifd uses @Autowired for:
        - BroadcastEventProcessor (m_eventReader)
        - NotifdConfigManager (m_configManager)
        - NodeDao (m_nodeDao)
        - NotificationManager (m_notificationManager)
      All are resolved by type from this context via annotation-config.
    -->
    <bean name="daemon" class="org.opennms.netmgt.notifd.Notifd"/>

    <!-- ============================================================== -->
    <!-- Daemon Lifecycle (replaces Manager)                            -->
    <!-- ============================================================== -->

    <bean name="daemonLifecycleManager"
          class="org.opennms.core.daemon.loader.DaemonLifecycleManager">
        <constructor-arg ref="daemon"/>
    </bean>

</beans>
