<?xml version="1.0" encoding="UTF-8"?>
<!--
  Karaf-only Pollerd loader context.

  In a Karaf-only container (no Manager, no Eventd), this context replaces the
  7-level Spring hierarchy (soaContext → commonContext → daemonContext → daoContext
  → pollerConfigContext → thresholdingContext → pollerdContext) with a flat context
  that wires Pollerd beans directly to OSGi services.

  All dependencies come from OSGi service registry:
  - EventIpcManager from KafkaEventIpcManagerAdapter (event-forwarder-kafka feature)
  - DAOs from distributed DAO feature (via SOA ServiceRegistry)
  - PollerConfig created locally (opennms-config has no Spring-Context header)
  - ThresholdingService from thresholding feature
  - PersisterFactory from collection persistence feature
  - LocationAwarePingClient from RPC ICMP feature
-->
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xmlns:osgi="http://www.springframework.org/schema/osgi"
       xmlns:onmsgi="http://xmlns.opennms.org/xsd/spring/onms-osgi"
       xsi:schemaLocation="
           http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-4.2.xsd
           http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context-4.2.xsd
           http://www.springframework.org/schema/osgi http://www.springframework.org/schema/osgi/spring-osgi.xsd
           http://xmlns.opennms.org/xsd/spring/onms-osgi http://xmlns.opennms.org/xsd/spring/onms-osgi.xsd
       ">

    <!-- Enable @Autowired processing for Poller and QueryManagerDaoImpl -->
    <context:annotation-config />

    <!-- Shared KafkaRpcClientFactory wiring -->
    <import resource="classpath:kafka-rpc-client-factory.xml"/>

    <!-- ServiceRegistry: import the shared instance from OSGi (registered by
         service-registry module) rather than creating a local one with
         <onmsgi:default-registry/> which would be a different, empty instance -->
    <osgi:reference id="serviceRegistry"
                    interface="org.opennms.core.soa.ServiceRegistry"/>

    <!-- ============================================================== -->
    <!-- OSGi Service References (from other Karaf features)            -->
    <!-- ============================================================== -->

    <!-- Event infrastructure (from opennms-event-forwarder-kafka blueprint)
         Uses osgi:reference because event-forwarder-kafka registers services
         via Aries Blueprint <service> in the OSGi framework registry,
         not in the OpenNMS ServiceRegistry used by onmsgi namespace. -->
    <osgi:reference id="eventIpcManager"
                    interface="org.opennms.netmgt.events.api.EventIpcManager"/>

    <!-- Poller configuration: created locally because the opennms-config bundle
         has no Spring-Context header, so Spring-DM never loads its XML configs.
         Requires poller-configuration.xml in ${opennms.home}/etc/ -->
    <bean id="init-pollerConfig-factory"
          class="org.springframework.beans.factory.config.MethodInvokingFactoryBean">
        <property name="staticMethod">
            <value>org.opennms.netmgt.config.PollerConfigFactory.init</value>
        </property>
    </bean>
    <bean id="pollerConfig" class="org.opennms.netmgt.config.PollerConfigFactory"
          depends-on="init-pollerConfig-factory" factory-method="getInstance"/>

    <!-- ICMP ping client (from RPC ICMP feature, optional — not in minimal daemon) -->
    <onmsgi:reference id="locationAwarePingClient"
                      interface="org.opennms.netmgt.icmp.proxy.LocationAwarePingClient"/>

    <!-- Collection persistence (from timeseries feature, optional for polling-only mode) -->
    <onmsgi:reference id="persisterFactory"
                      interface="org.opennms.netmgt.collection.api.PersisterFactory"/>

    <!-- Thresholding (from sentinel-thresholding-service feature, optional for polling-only mode) -->
    <onmsgi:reference id="thresholdingService"
                      interface="org.opennms.netmgt.threshd.api.ThresholdingService"/>

    <!-- DAOs (from opennms-persistence / opennms-distributed-core-impl via SOA ServiceRegistry) -->
    <onmsgi:reference id="nodeDao"
                      interface="org.opennms.netmgt.dao.api.NodeDao"/>
    <onmsgi:reference id="outageDao"
                      interface="org.opennms.netmgt.dao.api.OutageDao"/>
    <onmsgi:reference id="monitoredServiceDao"
                      interface="org.opennms.netmgt.dao.api.MonitoredServiceDao"/>
    <onmsgi:reference id="ipInterfaceDao"
                      interface="org.opennms.netmgt.dao.api.IpInterfaceDao"/>

    <!-- Transaction management (from opennms-persistence via SOA ServiceRegistry) -->
    <onmsgi:reference id="platformTransactionManager"
                      interface="org.springframework.transaction.PlatformTransactionManager"/>

    <osgi:reference id="distPollerDao"
                    interface="org.opennms.netmgt.dao.api.DistPollerDao"/>
    <onmsgi:reference id="entityScopeProvider"
                      interface="org.opennms.core.mate.api.EntityScopeProvider"/>
    <osgi:reference id="filterDao"
                    interface="org.opennms.netmgt.filter.api.FilterDao"/>
    <bean id="transactionTemplate"
          class="org.springframework.transaction.support.TransactionTemplate">
        <constructor-arg ref="platformTransactionManager"/>
    </bean>

    <!-- ============================================================== -->
    <!-- Local Beans (from daemon context, normally provided by Manager) -->
    <!-- ============================================================== -->

    <!-- Service monitor registry (discovers monitors via ServiceLoader) -->
    <bean id="serviceMonitorRegistry"
          class="org.opennms.core.daemon.loader.LocalServiceMonitorRegistry"/>

    <bean id="localHostName" class="org.opennms.core.utils.InetAddressUtils"
          factory-method="getLocalHostName"/>

    <bean id="pollerExecutor" class="java.util.concurrent.Executors"
          factory-method="newCachedThreadPool"/>

    <!-- Poller RPC module: serializes/deserializes poller request/response DTOs -->
    <bean id="pollerClientRpcModule"
          class="org.opennms.netmgt.poller.client.rpc.PollerClientRpcModule"/>

    <!-- Real LocationAwarePollerClient — delegates polls to Minions via Kafka RPC -->
    <bean id="locationAwarePollerClient"
          class="org.opennms.netmgt.poller.client.rpc.LocationAwarePollerClientImpl"/>
    <onmsgi:service interface="org.opennms.netmgt.poller.LocationAwarePollerClient"
                    ref="locationAwarePollerClient"/>

    <!-- ============================================================== -->
    <!-- Pollerd Beans (from pollerd context)                           -->
    <!-- ============================================================== -->

    <bean name="tsidFactory" class="org.opennms.core.tsid.TsidFactory">
        <constructor-arg value="0"/>
    </bean>

    <bean name="pollerQueryManager"
          class="org.opennms.netmgt.poller.QueryManagerDaoImpl"/>

    <bean name="pollContext" class="org.opennms.core.daemon.loader.StandalonePollContext">
        <property name="eventManager" ref="eventIpcManager"/>
        <property name="localHostName" ref="localHostName"/>
        <property name="name" value="OpenNMS.Poller.DefaultPollContext"/>
        <property name="pollerConfig" ref="pollerConfig"/>
        <property name="queryManager" ref="pollerQueryManager"/>
        <property name="locationAwarePingClient" ref="locationAwarePingClient"/>
        <property name="tsidFactory" ref="tsidFactory"/>
    </bean>

    <bean name="pollableNetwork"
          class="org.opennms.netmgt.poller.pollables.PollableNetwork">
        <constructor-arg ref="pollContext"/>
    </bean>

    <bean name="daemon" class="org.opennms.netmgt.poller.Poller">
        <property name="network" ref="pollableNetwork"/>
        <property name="pollerConfig" ref="pollerConfig"/>
        <property name="eventIpcManager" ref="eventIpcManager"/>
    </bean>

    <!-- ============================================================== -->
    <!-- PassiveStatusKeeper — same JVM as Pollerd so                   -->
    <!-- PassiveServiceMonitor.poll() can access the singleton          -->
    <!-- ============================================================== -->

    <!-- DataSource (from distributed datasource blueprint) -->
    <osgi:reference id="dataSource"
                    interface="javax.sql.DataSource"/>

    <!-- Register this instance as the singleton so PassiveServiceMonitor can find it -->
    <bean id="passiveStatusKeeper-init" class="org.springframework.beans.factory.config.MethodInvokingBean">
        <property name="staticMethod"
                  value="org.opennms.netmgt.passive.PassiveStatusKeeper.setInstance"/>
        <property name="arguments">
            <list>
                <ref bean="passiveStatusKeeper"/>
            </list>
        </property>
    </bean>

    <!-- PassiveStatusKeeper implements EventListener directly and subscribes
         in onInit() via getEventManager().addEventListener(this, PASSIVE_STATUS_UEI).
         init-method="init" triggers AbstractServiceDaemon.init() → onInit(). -->
    <bean id="passiveStatusKeeper" class="org.opennms.netmgt.passive.PassiveStatusKeeper"
          init-method="init" destroy-method="stop">
        <property name="eventManager" ref="eventIpcManager"/>
        <property name="dataSource" ref="dataSource"/>
    </bean>

    <!-- Register PassiveServiceMonitor in the ServiceMonitorRegistry.
         In OSGi, ServiceLoader can't discover monitors across bundle boundaries.
         This explicit registration bridges that gap. -->
    <bean id="passiveServiceMonitorRegistrar"
          class="org.opennms.core.daemon.loader.PassiveServiceMonitorRegistrar"
          init-method="init"
          depends-on="daemon"/>

    <!-- Publish passive status to Minion via Twin API so PassiveServiceMonitor
         can execute on Minion instead of forcing Default location -->
    <osgi:reference id="twinPublisher"
                    interface="org.opennms.core.ipc.twin.api.TwinPublisher"/>

    <bean id="passiveStatusTwinPublisher"
          class="org.opennms.netmgt.passive.PassiveStatusTwinPublisher"
          init-method="init" destroy-method="close"
          depends-on="passiveStatusKeeper">
        <constructor-arg ref="twinPublisher"/>
        <constructor-arg ref="passiveStatusKeeper"/>
        <constructor-arg ref="eventIpcManager"/>
    </bean>

    <!-- ============================================================== -->
    <!-- Daemon Lifecycle (replaces Manager)                            -->
    <!-- ============================================================== -->

    <bean name="daemonLifecycleManager"
          class="org.opennms.core.daemon.loader.DaemonLifecycleManager">
        <constructor-arg ref="daemon"/>
    </bean>

</beans>
