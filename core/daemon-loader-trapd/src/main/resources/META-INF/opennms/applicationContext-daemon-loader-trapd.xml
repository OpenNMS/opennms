<?xml version="1.0" encoding="UTF-8"?>
<!--
  Karaf-only Trapd loader context.

  In a Karaf-only container (no Manager, no Eventd), this context replaces the
  multi-level Spring hierarchy with a flat context that wires Trapd beans
  directly to OSGi services.

  Trapd is a UDP listener (port 1162) that receives SNMP traps, converts them
  to OpenNMS events, and forwards them via the Sink API. Key components:

  - Trapd: the daemon itself, manages TrapListener lifecycle and TwinPublisher
  - TrapListener: opens UDP socket, receives SNMP traps, dispatches via Sink API
  - TrapSinkConsumer: consumes trap messages from Sink, converts to events, forwards

  All dependencies come from the OSGi service registry:
  - EventIpcManager from KafkaEventIpcManagerAdapter (event-forwarder-kafka feature)
  - TrapdConfig from opennms-config feature (TrapdConfigFactory)
  - SecureCredentialsVault from SCV feature
  - TwinPublisher/TwinSubscriber from IPC Twin feature
  - MessageDispatcherFactory/MessageConsumerManager from Sink API feature
  - DAOs from distributed DAO feature
-->
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xmlns:osgi="http://www.springframework.org/schema/osgi"
       xmlns:onmsgi="http://xmlns.opennms.org/xsd/spring/onms-osgi"
       xsi:schemaLocation="
           http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-4.2.xsd
           http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context-4.2.xsd
           http://www.springframework.org/schema/osgi http://www.springframework.org/schema/osgi/spring-osgi.xsd
           http://xmlns.opennms.org/xsd/spring/onms-osgi http://xmlns.opennms.org/xsd/spring/onms-osgi.xsd
       ">

    <!-- Enable @Autowired processing for Trapd, TrapListener, TrapSinkConsumer -->
    <context:annotation-config />

    <!-- ServiceRegistry: import the shared instance from OSGi (registered by
         service-registry module) rather than creating a local one with
         <onmsgi:default-registry/> which would be a different, empty instance -->
    <osgi:reference id="serviceRegistry"
                    interface="org.opennms.core.soa.ServiceRegistry"/>

    <!-- ============================================================== -->
    <!-- OSGi Service References (from other Karaf features)            -->
    <!-- ============================================================== -->

    <!-- Event infrastructure (from opennms-event-forwarder-kafka blueprint) -->
    <osgi:reference id="eventIpcManager"
                    interface="org.opennms.netmgt.events.api.EventIpcManager"/>

    <!-- EventSubscriptionService (from opennms-event-forwarder-kafka blueprint) -->
    <osgi:reference id="eventSubscriptionService"
                    interface="org.opennms.netmgt.events.api.EventSubscriptionService"/>

    <!-- Trap configuration: initialize the static factory singleton locally.
         The opennms-config bundle has no Spring-Context header, so applicationContext-commonConfigs.xml
         is never loaded by Spring DM in the daemon container. We must init the factory here.
         Trapd() constructor calls TrapdConfigFactory.getInstance(), so init must run first. -->
    <bean id="trapdConfig-init" class="org.springframework.beans.factory.config.MethodInvokingFactoryBean">
        <property name="staticMethod"><value>org.opennms.netmgt.config.TrapdConfigFactory.init</value></property>
    </bean>
    <bean id="trapdConfig" class="org.opennms.netmgt.config.TrapdConfigFactory"
          depends-on="trapdConfig-init" factory-method="getInstance"/>

    <!-- Event configuration DAO (for TrapSinkConsumer event matching).
         The opennms-config bundle has no Spring-Context header, so DefaultEventConfDao
         is never created by Spring DM. Create it locally and load event definitions
         from the database so traps are properly matched to UEIs and alarm-data. -->
    <bean id="eventConfDao" class="org.opennms.netmgt.config.DefaultEventConfDao"/>

    <!-- EventConfEventDao: Hibernate DAO for event_conf_event table.
         Registered by distributed-dao-impl (applicationContext-shared.xml). -->
    <onmsgi:reference id="eventConfEventDao"
                      interface="org.opennms.netmgt.dao.api.EventConfEventDao"/>

    <!-- Load event definitions from DB into EventConfDao on startup.
         Without this, EventConfDao is empty and all traps get "uei.opennms.org/default/trap".
         Uses a class in this bundle (not MethodInvokingBean) to avoid OSGi classloader
         issues — MethodInvokingBean reflects via the Spring classloader which can't
         resolve eventconf model classes. -->
    <bean id="eventConfLoader" class="org.opennms.core.daemon.loader.EventConfInitializer">
        <constructor-arg ref="eventConfEventDao"/>
        <constructor-arg ref="eventConfDao"/>
    </bean>

    <!-- Secure Credentials Vault (for SNMPv3 credential interpolation) -->
    <onmsgi:reference id="secureCredentialsVault"
                      interface="org.opennms.features.scv.api.SecureCredentialsVault"/>

    <!-- Twin API: in-process implementation (standalone: no remote Minions).
         Trapd publishes config via TwinPublisher, TrapListener subscribes via TwinSubscriber.
         The subscriber must deliver published values in-process so TrapListener opens
         the UDP socket when it receives the trap config. -->
    <bean id="twinPublisher" class="org.opennms.core.daemon.loader.NoOpTwinPublisher"/>
    <bean id="twinSubscriber" factory-bean="twinPublisher" factory-method="createSubscriber"/>

    <!-- Sink API: local in-process dispatch + Kafka Sink bridge for Minion-forwarded traps.
         The KafkaSinkBridge consumes from the Kafka Sink topic (OpenNMS.Sink.Trap) and
         dispatches to the LocalMessageConsumerManager, which delivers to TrapSinkConsumer.
         This enables the full Minion → Kafka → Trapd pipeline. -->
    <bean id="messageConsumerManager"
          class="org.opennms.core.daemon.loader.LocalMessageConsumerManager">
        <property name="kafkaSinkBridge" ref="kafkaSinkBridge"/>
    </bean>
    <bean id="kafkaSinkBridge"
          class="org.opennms.core.daemon.loader.KafkaSinkBridge"
          init-method="afterPropertiesSet" destroy-method="destroy">
        <constructor-arg ref="messageConsumerManager"/>
    </bean>
    <bean id="messageDispatcherFactory"
          class="org.opennms.core.daemon.loader.LocalMessageDispatcherFactory">
        <constructor-arg ref="messageConsumerManager"/>
    </bean>

    <!-- DAOs (from distributed DAO feature).
         distPollerDao and interfaceToNodeCache use <osgi:reference> (not <onmsgi:reference>)
         because TrapSinkConsumer.init() calls distPollerDao.whoami() during @PostConstruct.
         The onmsgi proxy would throw IllegalStateException if the DAO isn't registered yet;
         osgi:reference blocks context startup until the service is available. -->
    <osgi:reference id="distPollerDao"
                    interface="org.opennms.netmgt.dao.api.DistPollerDao"/>
    <osgi:reference id="interfaceToNodeCache"
                    interface="org.opennms.netmgt.dao.api.InterfaceToNodeCache"/>

    <!-- ============================================================== -->
    <!-- Trapd Beans                                                    -->
    <!-- ============================================================== -->

    <!-- Metrics for the trap listener -->
    <bean id="trapListenerMetricRegistry" class="com.codahale.metrics.MetricRegistry"/>

    <bean id="trapListenerMetrics" class="org.opennms.netmgt.trapd.TrapListenerMetrics"
          init-method="startJmxReporter" destroy-method="stopJmxReporter">
        <constructor-arg ref="trapListenerMetricRegistry"/>
    </bean>

    <!-- TrapListener: opens UDP socket, receives SNMP traps -->
    <bean id="trapListener" class="org.opennms.netmgt.trapd.TrapListener">
        <constructor-arg ref="trapdConfig"/>
        <property name="trapListenerMetrics" ref="trapListenerMetrics"/>
    </bean>

    <!-- Bind TwinSubscriber to TrapListener so it receives config updates.
         Without this, TrapListener falls back to a 60-second delayed check that
         may fail silently. bind() wires subscribe→publish in-process. -->
    <bean class="org.springframework.beans.factory.config.MethodInvokingBean">
        <property name="targetObject" ref="trapListener"/>
        <property name="targetMethod" value="bind"/>
        <property name="arguments">
            <list><ref bean="twinSubscriber"/></list>
        </property>
    </bean>

    <!-- TrapSinkConsumer: consumes trap messages, creates events, forwards them -->
    <bean id="trapSinkConsumer" class="org.opennms.netmgt.trapd.TrapSinkConsumer"/>

    <!-- Trapd daemon.
         depends-on ensures TrapdConfigFactory.init() and event conf loading both
         complete before the Trapd() constructor runs. -->
    <bean id="daemon" class="org.opennms.netmgt.trapd.Trapd"
          depends-on="trapdConfig,eventConfLoader">
        <property name="secureCredentialsVault" ref="secureCredentialsVault"/>
    </bean>

    <!-- @EventHandler adapter for non-internal events (delivered via Kafka) -->
    <bean id="daemonListener" class="org.opennms.netmgt.events.api.AnnotationBasedEventListenerAdapter">
        <property name="annotatedListener" ref="daemon"/>
        <property name="eventSubscriptionService" ref="eventSubscriptionService"/>
    </bean>

    <!-- ============================================================== -->
    <!-- Daemon Lifecycle (replaces Manager)                            -->
    <!-- ============================================================== -->

    <bean name="daemonLifecycleManager"
          class="org.opennms.core.daemon.loader.DaemonLifecycleManager">
        <constructor-arg ref="daemon"/>
    </bean>

</beans>
