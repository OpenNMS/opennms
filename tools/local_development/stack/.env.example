# Copy to .env and adjust as needed: cp .env.example .env

# --- Images / versions ------------------------------------------------------
# Last published Horizon release. Override to run a different tag, or use
# compose.local.yml to run the image built from this branch.
ONMS_IMAGE=opennms/horizon:36.0.2
ONMS_LOCAL_IMAGE=opennms/horizon:37.0.0-SNAPSHOT

POSTGRES_VERSION=15
VM_VERSION=v1.148.0
GRAFANA_VERSION=11.6.0
CURL_VERSION=8.11.1

# Prometheus RemoteWrite plugin release on Maven Central.
# https://github.com/OpenNMS-Plugins/opennms-prometheus-remotewrite-plugin
PLUGIN_VERSION=2.1.0

# --- Runtime ----------------------------------------------------------------
TIMEZONE=UTC
ONMS_JAVA_OPTS=-Xmx2g -XX:MaxMetaspaceSize=512m
VM_RETENTION=30d
GRAFANA_PASSWORD=admin

# --- Published host ports ---------------------------------------------------
# Change these if something already owns the default -- a locally built OpenNMS
# holds 8980 and 8101, for example.
ONMS_HTTP_PORT=8980
ONMS_KARAF_PORT=8101
ONMS_TRAPD_PORT=1162
ONMS_SYSLOG_PORT=10514
VM_HTTP_PORT=8428
GRAFANA_PORT=3000
