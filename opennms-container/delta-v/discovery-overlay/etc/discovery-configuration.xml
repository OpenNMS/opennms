<discovery-configuration xmlns="http://xmlns.opennms.org/xsd/config/discovery"
    packets-per-second="1"
    initial-sleep-time="10000"
    restart-sleep-time="86400000"
    retries="2"
    timeout="3000">

    <!-- Discover the postgres container (known to be reachable within Docker network) -->
    <specific retries="2" timeout="3000" foreign-source="delta-v-hosts">postgres</specific>

</discovery-configuration>
