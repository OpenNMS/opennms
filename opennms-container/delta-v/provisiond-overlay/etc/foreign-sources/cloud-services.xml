<?xml version="1.0" encoding="UTF-8"?>
<!--
  Foreign source definition for cloud service passive monitoring.
  Uses LoopDetector to auto-assign passive services to all interfaces.
  Services are monitored by PassiveServiceMonitor (status driven by syslog events).
-->
<foreign-source xmlns="http://xmlns.opennms.org/xsd/config/foreign-source" name="cloud-services">
    <scan-interval>1d</scan-interval>
    <detectors>
        <detector name="GoogleCloud" class="org.opennms.netmgt.provision.detector.loop.LoopDetector">
            <parameter key="ipMatch" value="*.*.*.*"/>
            <parameter key="is-supported" value="true"/>
        </detector>
        <detector name="Azure" class="org.opennms.netmgt.provision.detector.loop.LoopDetector">
            <parameter key="ipMatch" value="*.*.*.*"/>
            <parameter key="is-supported" value="true"/>
        </detector>
        <detector name="AWS" class="org.opennms.netmgt.provision.detector.loop.LoopDetector">
            <parameter key="ipMatch" value="*.*.*.*"/>
            <parameter key="is-supported" value="true"/>
        </detector>
    </detectors>
    <policies/>
</foreign-source>
