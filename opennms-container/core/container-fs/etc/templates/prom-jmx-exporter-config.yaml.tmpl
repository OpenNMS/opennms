startDelaySeconds: ${PROM_JMX_START_DELAY_SECONDS}
lowercaseOutputName: ${PROM_JMX_LOWERCASE_OUTPUT_NAME}
lowercaseOutputLabelNames: ${PROM_JMX_LOWERCASE_OUTPUT_LABEL_NAMES}
autoExcludeObjectNameAttributes: ${PROM_JMX_AUTO_EXCLUDE_OBJECT_NAME_ATTRIBUTES}

includeObjectNames:
  - "java.lang:*"
  - "OpenNMS:*"
  - "org.opennms.*:*"
  - "org.opennms.newts:name=ring-buffer*"
  - "org.opennms.newts:name=repository.samples-inserted*"
  - "org.opennms.core.ipc.rpc:*"
  - "com.zaxxer.hikari:*"

# The specific list of scheduled objects for Pollerd and Collectd are not exposed to Prometheus.
excludeObjectNameAttributes:
  "OpenNMS:Name=Pollerd":
    - "Schedule"
  "OpenNMS:Name=Collectd":
    - "Schedule"

rules:
  - pattern: "java.lang.*"
    cache: true
  - pattern: "OpenNMS.*"
    cache: true
  # Per-device trapd metrics (must be before generic org.opennms.* pattern)
  - pattern: 'org\.opennms\.netmgt\.trapd\.device<location="([^"]+)", ip="([^"]+)", type=([^>]+)><>(\w+)'
    name: trapd_device_$4
    type: COUNTER
    cache: true
    labels:
      location: "$1"
      ip: "$2"
      type: "$3"
  - pattern: "org.opennms.*"
    cache: true
  - pattern: "com.zaxxer.hikari.*"
    cache: true
  - pattern: "org.opennms.core.ipc.rpc<name=([^.,]*).([^.,]*).([^.,]*).*Count*"
    name: org_opennms_core_ipc_rpc_count
    cache: true
    labels:
      destination: $1
      type: $2
      metric: $3
  - pattern: "org.opennms.core.ipc.rpc<name=([^.,]*).([^.,]*).([^.,]*).*Mean*"
    name: org_opennms_core_ipc_rpc_mean
    cache: true
    labels:
      destination: $1
      type: $2
      metric: $3
