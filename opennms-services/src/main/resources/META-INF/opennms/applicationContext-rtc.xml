<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:context="http://www.springframework.org/schema/context"
  xmlns:onmsgi="http://xmlns.opennms.org/xsd/spring/onms-osgi"
  xsi:schemaLocation="
  http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-4.2.xsd
  http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context-4.2.xsd
  http://xmlns.opennms.org/xsd/spring/onms-osgi http://xmlns.opennms.org/xsd/spring/onms-osgi.xsd
">

  <context:annotation-config />

  <!-- Category definitions come from categories.xml; the calculator and the snapshot store come from the DAO context. -->
  <bean id="categoryDefinitionProvider" class="org.opennms.netmgt.availability.CategoriesXmlDefinitionProvider"/>

  <bean id="categoryAvailabilityThresholdNotifier" class="org.opennms.netmgt.availability.CategoryAvailabilityThresholdNotifier">
    <constructor-arg>
      <onmsgi:reference interface="org.opennms.netmgt.events.api.EventForwarder"/>
    </constructor-arg>
  </bean>

  <bean id="availabilitySnapshotScheduler" class="org.opennms.netmgt.availability.AvailabilitySnapshotScheduler">
    <constructor-arg ref="categoryAvailabilityCalculator"/>
    <constructor-arg ref="categoryAvailabilitySnapshotDao"/>
    <constructor-arg ref="categoryDefinitionProvider"/>
    <property name="thresholdNotifier" ref="categoryAvailabilityThresholdNotifier"/>
  </bean>

  <bean name="daemon" class="org.opennms.netmgt.rtc.RTCManager"/>

</beans>
