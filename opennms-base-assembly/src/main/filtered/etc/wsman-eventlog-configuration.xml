<?xml version="1.0" encoding="UTF-8"?>
<!--
  WS-Man Event Log daemon (WsManEventLogd): reads Windows event logs over WinRM and
  publishes one OpenNMS event per record. Credentials and endpoints come from
  wsman-config.xml; a node is read when an interface matching the package filter
  carries the WS-Man service.

  threads:                  concurrent node polls across all packages
  retries:                  WS-Man retries per read, on top of the first attempt
  target-refresh-interval:  how long the node list behind a filter is reused (e.g. 5m)

  log attributes:
    interval          poll interval in milliseconds
    max-records       records read per poll; the rest wait for the next poll
    lookback          how far back the first poll of a node reads (30s, 15m, 1h, 2d)
    levels            Error,Warning,Information,AuditSuccess,AuditFailure (empty = all)
    include-event-ids / exclude-event-ids   comma-separated Event IDs
    mode              wql (Win32_NTLogEvent: the classic Application, System and Security
                      logs). Reading the "Applications and Services" logs through
                      Get-WinEvent is not available in this release.

  event-mapping gives one Event ID (optionally in one log and from one source) its
  own UEI and severity; every other record uses uei.opennms.org/wsman/eventlog/<log>.
-->
<wsman-eventlog-configuration xmlns="http://xmlns.opennms.org/xsd/config/wsman-eventlog" threads="4" retries="1" target-refresh-interval="5m">
  <package name="windows-servers">
    <filter>IPADDR != '0.0.0.0'</filter>
    <log name="System" interval="60000" max-records="500" lookback="1h" levels="Error,Warning"/>
    <log name="Application" interval="60000" max-records="500" lookback="1h" levels="Error,Warning"/>
    <!-- Security stays off by default because of its volume; when enabled, only the
         account, group, lockout and audit-policy IDs mapped below are read -->
    <log name="Security" enabled="false" interval="60000" max-records="500" lookback="15m" include-event-ids="1102,4625,4719,4720,4724,4726,4728,4732,4740,4756"/>
    <!-- Reserved for a later release: "Applications and Services" logs through Get-WinEvent.
    <log name="Microsoft-Windows-TaskScheduler/Operational" enabled="false" mode="shell" interval="300000" max-records="200" lookback="1h" levels="Error,Warning"/>
    -->
    <event-mapping logfile="System" event-id="6008" uei="uei.opennms.org/wsman/eventlog/unexpectedShutdown" severity="Major"/>
    <event-mapping logfile="Security" event-id="4625" uei="uei.opennms.org/wsman/eventlog/logonFailure" severity="Minor"/>
    <event-mapping logfile="Security" event-id="4740" uei="uei.opennms.org/wsman/eventlog/accountLockedOut" severity="Major"/>
    <event-mapping logfile="Security" event-id="1102" uei="uei.opennms.org/wsman/eventlog/auditLogCleared" severity="Major"/>
    <event-mapping logfile="Security" event-id="4719" uei="uei.opennms.org/wsman/eventlog/auditPolicyChanged" severity="Major"/>
    <event-mapping logfile="Security" event-id="4720" uei="uei.opennms.org/wsman/eventlog/userAccountCreated" severity="Warning"/>
    <event-mapping logfile="Security" event-id="4726" uei="uei.opennms.org/wsman/eventlog/userAccountDeleted" severity="Warning"/>
    <event-mapping logfile="Security" event-id="4724" uei="uei.opennms.org/wsman/eventlog/passwordResetAttempt" severity="Warning"/>
    <event-mapping logfile="Security" event-id="4728" uei="uei.opennms.org/wsman/eventlog/groupMemberAdded" severity="Warning"/>
    <event-mapping logfile="Security" event-id="4732" uei="uei.opennms.org/wsman/eventlog/groupMemberAdded" severity="Warning"/>
    <event-mapping logfile="Security" event-id="4756" uei="uei.opennms.org/wsman/eventlog/groupMemberAdded" severity="Warning"/>
  </package>
</wsman-eventlog-configuration>
