{
  "name": "web",
  "version": "0.0.0",
  "license": "AGPL v3",
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build --base=/opennms/ui/",
    "build:all": "concurrently \"pnpm run build\" \"pnpm run build:menu\"",
    "build:menu": "vue-tsc --noEmit && vite build --config ./vite.config.menu.ts --base=/opennms/ui/",
    "build:dev": "vue-tsc --noEmit && vite build --base=/opennms/ui/ --minify false",
    "build:dev:menu": "vue-tsc --noEmit && vite build --config ./vite.config.menu.ts --base=/opennms/ui/ --minify false",
    "build:dev:all": "concurrently \"pnpm run build:dev\" \"pnpm run build:dev:menu\"",
    "watch": "vue-tsc --noEmit && vite build --base=/opennms/ui/ --watch",
    "watch:dev": "vue-tsc --noEmit && vite build --base=/opennms/ui/ --minify false --watch",
    "serve": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest --coverage",
    "test:coverage:sonar": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-regular-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/vue-fontawesome": "^3.0.6",
    "@primevue/themes": "^4.5.4",
    "@vueuse/core": "^9.13.0",
    "ace-builds": "^1.32.6",
    "axios": "^1.15.0",
    "chart.js": "^3.9.1",
    "chartjs-plugin-zoom": "^2.0.1",
    "cronstrue": "^3.9.0",
    "d3": "^7.8.5",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.2.3",
    "fast-xml-parser": "^5.5.11",
    "ip-regex": "^5.0.0",
    "is-ip": "^5.0.1",
    "is-valid-domain": "^0.1.6",
    "leaflet": "^1.8.0",
    "leaflet.markercluster": "^1.5.3",
    "lodash": "^4.18.1",
    "marked": "^12.0.2",
    "pinia": "^2.1.6",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.4",
    "rapidoc": "^9.3.8",
    "sass": "^1.75.0",
    "sass-loader": "^14.1.1",
    "splitpanes": "^3.1.5",
    "uuid": "^14.0.0",
    "vite-svg-loader": "^4.0.0",
    "vkbeautify": "^0.99.3",
    "vue": "^3.5.33",
    "vue-diff": "^1.2.4",
    "vue-router": "^4.2.4",
    "vue3-ace-editor": "^2.2.4",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@pinia/testing": "^0.1.3",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/d3": "^7.4.0",
    "@types/diff": "^5.0.3",
    "@types/leaflet": "^1.9.11",
    "@types/leaflet.markercluster": "^1.5.1",
    "@types/lodash": "^4.14.196",
    "@types/marked": "^4.0.3",
    "@types/node": ">=20",
    "@types/splitpanes": "^2.2.1",
    "@types/uuid": "^10.0.0",
    "@types/vkbeautify": "^0.99.4",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue-leaflet/vue-leaflet": "^0.7.0",
    "@vue/test-utils": "^2.4.5",
    "concurrently": "^9.2.1",
    "diff": "^8.0.4",
    "eslint": "^10.4.1",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.6.0",
    "happy-dom": "^9.20.3",
    "typescript": "~5.4.5",
    "typescript-eslint": "^8.61.0",
    "unplugin-vue-components": "^0.26.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.10",
    "vitest-mock-extended": "^1.3.1",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.2.12"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "@antfu/utils": "^0.7.3",
      "ajv": "^6.14.0",
      "brace-expansion@>=1 <2": "^1.1.13",
      "brace-expansion@>=2 <3": "^2.0.3",
      "brace-expansion@>=5 <6": "^5.0.5",
      "flatted": "^3.4.1",
      "immutable": "^5.1.5",
      "micromatch": "^4.0.8",
      "minimatch@>=7 <8": "^7.4.8",
      "minimatch@>=9 <10": "^9.0.8",
      "picomatch@>=2 <3": "^2.3.2",
      "picomatch@>=4 <5": "^4.0.4",
      "prismjs": "^1.30.0",
      "rollup": "^4.59.0",
      "svgo": "^3.3.3",
      "undici": "5.28.4"
    }
  }
}
